# Server
PORT=5000

# Firebase Admin SDK
# Generate this from: Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the downloaded JSON file's contents as a single line here, OR point to a file path.
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json

# The Firebase project's Realtime/Firestore database URL (if using Realtime DB features)
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
